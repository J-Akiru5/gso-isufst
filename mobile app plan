## Phase 1: Critical Database & Schema Fixes

### [NEW] `migrations/20260511080000_fix_schema_gaps.sql`
```sql
-- 1. Add 'driver' and 'ssc_staff' roles
INSERT INTO roles (name, display_name, description, is_system, permissions) VALUES
  ('driver', 'Driver', 'Assigned to drive university vehicles', true, '{"travel":["read_assigned","update_status"]}'),
  ('ssc_staff', 'SSC Staff', 'Student Support Center — approves student event bookings', true, '{"bookings":["read","approve"]}')
ON CONFLICT (name) DO NOTHING;

-- 2. Add title/description to bookings
ALTER TABLE bookings ADD COLUMN IF NOT EXISTS title TEXT;
ALTER TABLE bookings ADD COLUMN IF NOT EXISTS description TEXT;

-- 3. Add passenger_names to travel_bookings
ALTER TABLE travel_bookings ADD COLUMN IF NOT EXISTS passenger_names TEXT;

-- 4. Travel booking number auto-generation
CREATE SEQUENCE IF NOT EXISTS travel_booking_seq START 1;
CREATE OR REPLACE FUNCTION generate_travel_booking_number()
RETURNS TRIGGER AS $$ BEGIN
  NEW.booking_number := 'TRV-' || EXTRACT(YEAR FROM NOW()) || '-' || LPAD(nextval('travel_booking_seq')::text, 4, '0');
  RETURN NEW;
END; $$ LANGUAGE plpgsql;
DROP TRIGGER IF EXISTS trg_travel_booking_number ON travel_bookings;
CREATE TRIGGER trg_travel_booking_number BEFORE INSERT ON travel_bookings
  FOR EACH ROW WHEN (NEW.booking_number IS NULL) EXECUTE FUNCTION generate_travel_booking_number();

-- 5. Fix travel RLS (drop overly permissive, add proper policies)
DROP POLICY IF EXISTS "Users can update their own bookings" ON travel_bookings;
CREATE POLICY "Requester can update own pending" ON travel_bookings
  FOR UPDATE USING (auth.uid() = requester_id AND status = 'Pending');
CREATE POLICY "Staff manage all travel" ON travel_bookings
  FOR ALL USING (has_any_role(ARRAY['super_admin','gso_staff']));
CREATE POLICY "Driver reads assigned trips" ON travel_bookings
  FOR SELECT USING (auth.uid() = driver_id);
CREATE POLICY "Driver updates assigned trips" ON travel_bookings
  FOR UPDATE USING (auth.uid() = driver_id AND status IN ('Scheduled','Ongoing'));

-- 6. SSC booking approval policy
CREATE POLICY "SSC approves bookings" ON bookings
  FOR UPDATE USING (has_any_role(ARRAY['super_admin','gso_staff','ssc_staff']));
```

