# ============================================================
# ISUFST GSO Management Portal — Environment Variables
# ============================================================
# Copy this file to .env.local (root) and fill in your values.
# NEVER commit .env.local to version control.

# ── Supabase ─────────────────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # KEEP SECRET — server-side only

# ── Firebase Cloud Messaging (Push Notifications) ─────────────
# Found at: Firebase Console → Project Settings → Cloud Messaging
NEXT_PUBLIC_FCM_VAPID_KEY=your-vapid-key-here          # For web push

# ── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="ISUFST Management Portal"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Flutter (add to apps/mobile_app/.env or dart-define) ──────
# These are passed via --dart-define at build time
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key-here
